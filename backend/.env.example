# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration via Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Example: mysql://root:your_secure_password@127.0.0.1:3306/greenloop
DATABASE_URL="mysql://YOUR_MYSQL_USER:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/greenloop"

# JWT Authentication
JWT_SECRET="greenloop_jwt_secret_production_ready_key_2026_super_secure"
JWT_EXPIRES_IN="7d"

# Client CORS URL
CLIENT_URL="http://localhost:5173"

# Upload Storage Directory
UPLOAD_DIR="./uploads"
